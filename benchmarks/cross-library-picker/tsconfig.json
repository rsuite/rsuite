{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "benchmark-adapter": ["src/adapters/rsuite.tsx"],
      "async-adapter": ["async/adapters/rsuite.tsx"]
    }
  },
  "include": ["src", "async"]
}
